{
  "name": "discord-bot",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "load": "npm run build && node dist/index.js load"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3"
  },
  "author": "SKAST",
  "license": "ISC",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.6.0",
    "@discordjs/voice": "^0.19.0",
    "@google/genai": "^1.34.0",
    "@ziplayer/extension": "0.3.3",
    "@ziplayer/plugin": "0.3.4",
    "@ziplayer/ytexecplug": "0.0.4",
    "axios": "^1.7.9",
    "discord.js": "^14.23.2",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "ziplayer": "0.3.13"
  },
  "keywords": [],
  "description": ""
}
