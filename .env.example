# ============================================================
# Discord Bot - Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Discord Bot Token (from Discord Developer Portal)
TOKEN=your_discord_bot_token

# Application (Client) ID (from Discord Developer Portal)
CLIENT_ID=your_application_id

# Guild IDs for slash command registration (comma-separated)
GUILD_IDS=guild_id_1,guild_id_2,guild_id_3

# ============================================================
# AI API Keys (at least one required for AI features)
# ============================================================

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

GROK_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ============================================================
# Local Music (optional - for /playlocal and /listlocal)
# ============================================================

MUSIC_FOLDER=C:\Users\Username\Music
